# Market data provider. Omit this to use the built-in simulator.
#   yahoo        — no key needed; US + Canadian (TSX) stocks, ETFs and crypto
#   finnhub     — stocks + crypto (crypto needs exchange pairs like BINANCE:BTCUSDT)
#   alphavantage — stocks/ETFs + registered crypto (BTC, ETH, SOL, ...)
#   mock        — always simulated, never real prices
MARKET_DATA_PROVIDER=finnhub

# API key for the provider above. Read on the server only, never exposed to the browser.
# Not required for Yahoo, which is keyless.
# Finnhub:   https://finnhub.io   (free key is 40 hex chars)
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
MARKET_API_KEY=

# Optional override if you proxy requests through your own gateway.
# MARKET_API_BASE_URL=

# Database. Leave unset to use the built-in file-backed SQLite database
# (./.data/finance.db) — perfect for local use. Set it to a PostgreSQL URL
# (Neon, Supabase, Railway, ...) for a hosted 24/7 deployment; the schema is
# created automatically on first request.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Set to "false" only when users reach the site over plain HTTP (e.g. a LAN
# address like http://192.168.1.5:3111). Leave unset for any HTTPS deployment.
# SESSION_COOKIE_SECURE=false
