# Market data provider. Omit this to use the built-in simulator.
#   finnhub     — stocks + crypto (crypto needs exchange pairs like BINANCE:BTCUSDT)
#   alphavantage — stocks/ETFs + registered crypto (BTC, ETH, SOL, ...)
#   mock        — always simulated, never real prices
MARKET_DATA_PROVIDER=finnhub

# API key for the provider above. Read on the server only, never exposed to the browser.
# Finnhub:   https://finnhub.io   (free key is 40 hex chars)
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
MARKET_API_KEY=

# Optional override if you proxy requests through your own gateway.
# MARKET_API_BASE_URL=
